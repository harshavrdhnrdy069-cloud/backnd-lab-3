  "item": [
    {
      "name": "GET Requests",
      "item": [
        {
          "name": "1. Get All Books (Default Parameters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Fetches all books with default pagination (limit=10, offset=0, order_by=id, order=ASC)."
          },
          "response": []
        },
        {
          "name": "2. Search Books by Partial Title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=Design",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search_q",
                  "value": "Design",
                  "description": "Performs partial search using SQL LIKE %Design%"
                }
              ]
            },
            "description": "Searches for books containing 'Design' in their title."
          },
          "response": []
        },
        {
          "name": "3. Sort by Price Ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "ASC"
                }
              ]
            },
            "description": "Sorts books by price from lowest to highest."
          },
          "response": []
        },
        {
          "name": "4. Sort by Price Descending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            },
            "description": "Sorts books by price from highest to lowest."
          },
          "response": []
        },
        {
          "name": "5. Pagination (Limit and Offset)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?limit=3&offset=2",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                },
                {
                  "key": "offset",
                  "value": "2"
                }
              ]
            },
            "description": "Skips the first 2 books and returns the next 3 books."
          },
          "response": []
        },
        {
          "name": "6. Filter by Minimum Price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=700",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "min_price",
                  "value": "700"
                }
              ]
            },
            "description": "Filters books with price >= 700."
          },
          "response": []
        },
        {
          "name": "7. Filter by Maximum Price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?max_price=500",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "max_price",
                  "value": "500"
                }
              ]
            },
            "description": "Filters books with price <= 500."
          },
          "response": []
        },
        {
          "name": "8. Combined Search, Sorting, Pagination and Price Range",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=Design&order_by=price&order=ASC&limit=5&offset=0&min_price=600&max_price=900",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search_q",
                  "value": "Design"
                },
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "ASC"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "min_price",
                  "value": "600"
                },
                {
                  "key": "max_price",
                  "value": "900"
                }
              ]
            },
            "description": "Demonstrates all query parameters functioning harmoniously together."
          },
          "response": []
        },
        {
          "name": "9. Get One Existing Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            },
            "description": "Fetches a single book with ID 1 (Expected Status: 200)."
